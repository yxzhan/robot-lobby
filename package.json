{
  "name": "robot-lobby",
  "version": "1.0.0",
  "description": "A multiplayer MuJoCo sandbox in the browser: MuJoCo physics (WASM or a shared Python server), Filament rendering",
  "scripts": {
    "postinstall": "node scripts/vendor.mjs && python3 scripts/thumbnails.py",
    "client": "python3 scripts/serve.py 4007",
    "server": "python3 server/server.py 4007",
    "all": "node scripts/vendor.mjs && python3 scripts/thumbnails.py && python3 server/server.py 4007"
  },
  "license": "ISC",
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@mujoco/mujoco": "3.15.0",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "filament": "1.53.4",
    "onnxruntime-web": "1.30.0",
    "pyodide": "314.0.7",
    "qrcode-generator": "2.0.4",
    "stats.js": "0.17.0"
  },
  "private": true
}
