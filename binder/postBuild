#!/bin/bash
# The Binder image: vendors the page's runtimes (npm ci), links the model
# library, which is not in the image but a volume mounted into the user pod
# at MJCF_ASSETS, as public/mjcf_assets, and sets up the world server behind
# jupyter-server-proxy (jupyter_server_config.py). The library is only there
# once the pod runs, so binder/start indexes it then.
set -euo pipefail

npm ci  # its postinstall indexes an empty library here
npm cache clean --force
ln -sfn "${MJCF_ASSETS:-/mnt/dev-tools/mjcf_assets}" public/mjcf_assets

mkdir -p ~/.jupyter
cp binder/jupyter_server_config.py ~/.jupyter/
