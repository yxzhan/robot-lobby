#!/bin/bash
# Runs as the pod starts, before Jupyter: indexes the mounted model library
# (public/mjcf_assets, see postBuild) and the policies for the page's asset
# panel, and makes the thumbnails, a few seconds. A missing library leaves
# the panel empty but does not stop the session.
(
  cd "${REPO_DIR:-$HOME}" &&
  node scripts/vendor.mjs > /tmp/index.log 2>&1 &&
  python3 scripts/thumbnails.py >> /tmp/index.log 2>&1
) || echo "indexing the model library failed, see /tmp/index.log"
exec "$@"
