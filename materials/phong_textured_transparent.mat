// phong_textured.mat alpha blended: the texture (with its own alpha) times the material rgba.
material {
    name : mujoco_phong_textured_transparent,
    shadingModel : specularGlossiness,
    doubleSided : true,  // instances are one-sided unless set (environments: one-sided walls)
    blending : transparent,
    requires : [ uv0 ],
    parameters : [
        { type : float4,    name : baseColor },
        { type : sampler2d, name : baseColorMap },
        { type : float,     name : specular },
        { type : float,     name : glossiness },
        { type : float3,    name : emissive }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 color = materialParams.baseColor * texture(materialParams_baseColorMap, getUV0());
        material.baseColor = vec4(color.rgb * color.a, color.a);
        material.specularColor = vec3(materialParams.specular);
        material.glossiness = materialParams.glossiness;
        material.emissive = vec4(materialParams.emissive, 0.0);
    }
}
