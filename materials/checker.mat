// Ground plane: procedural checkerboard in world XY (scene kept in MuJoCo Z-up coordinates).
material {
    name : mujoco_checker,
    shadingModel : lit,
    parameters : [
        { type : float3, name : color1 },
        { type : float3, name : color2 },
        { type : float,  name : scale }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        float3 p = getUserWorldPosition();
        float2 c = floor(p.xy / materialParams.scale);
        float k = mod(c.x + c.y, 2.0);
        material.baseColor.rgb = mix(materialParams.color1, materialParams.color2, k);
        material.roughness = 0.6;
        material.metallic = 0.0;
    }
}
